{
  "name": "hfg-particles",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:dev": "nodemon -i static/\\* -i js/\\* -i test/\\* server.js",
    "build": "node server.js build",
    "build:sass": "node server.js sass",
    "build:assets": "node server.js assets",
    "build:js": "node server.js js",
    "test": "npm run lint && npm run typecheck && npm run tests",
    "lint": "npx eslint --ext .js,.bundle,.ts js",
    "lint:fix": "npx eslint --fix --ext .js,.bundle,.ts js",
    "typecheck": "npx tsc --noEmit",
    "tests": "echo 'no tests available yet'",
    "deploy": "cd static && (git commit -am \"Update build to commit $(cd .. && git rev-parse --short HEAD)\" || true) && git push"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suluke/hfg-particles.git"
  },
  "author": "Lukas & Lukas",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/suluke/hfg-particles/issues"
  },
  "homepage": "https://github.com/suluke/hfg-particles#readme",
  "devDependencies": {
    "@rollup/plugin-buble": "^1.0.3",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^24.0.15",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^13.1.0",
    "eslint-plugin-import": "^2.14.0",
    "express": "^5.1.0",
    "ffmpeg.js": "^3.1.9001",
    "flickr-sdk": "^3.7.0",
    "font-awesome": "^4.7.0",
    "fs-extra": "^11.3.0",
    "git-rev": "^0.2.1",
    "image-capture": "^0.4.0",
    "nodemon": "^3.1.10",
    "parse-color": "^1.0.0",
    "regl": "^1.3.9",
    "rollup": "^4.45.1",
    "rollup-plugin-string": "^2.0.2",
    "sass": "^1.89.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}
